# ===========================================
# AI Usage Dashboard - Configuration
# ===========================================
# Copy this file to .env and fill in your API keys.
# Only enable the providers you want to track.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here
OPENAI_ORG_ID=org-your-org-id-here

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your-key-here

# Dashboard settings
# Host 0.0.0.0 allows access from other devices on your network
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5555

# How often to fetch new usage data (in minutes)
FETCH_INTERVAL_MINUTES=60

# Spending alerts (monthly, in USD) - set to 0 to disable
ALERT_THRESHOLD_WARNING=50.00
ALERT_THRESHOLD_CRITICAL=100.00
